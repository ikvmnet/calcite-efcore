<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);MAVEN0012</NoWarn>
        <AssemblyName>Apache.Calcite.EntityFrameworkCore.Benchmarks</AssemblyName>
        <RootNamespace>Apache.Calcite.EntityFrameworkCore.Benchmarks</RootNamespace>

        <!-- BenchmarkDotNet rebuilds the benchmark assembly into a generated project and refuses to run against a
             debug build; both are the defaults it expects of a benchmark host. -->
        <Optimize Condition=" '$(Configuration)' == 'Release' ">true</Optimize>
        <ServerGarbageCollection>false</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageReference Include="IKVM" Version="8.15.0" />
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    </ItemGroup>

    <ItemGroup>
        <MavenReference Include="org.apache.calcite:calcite-linq4j" Version="1.42.0" />
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.42.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Apache.Calcite.EntityFrameworkCore.Adapter\Apache.Calcite.EntityFrameworkCore.Adapter.csproj" />
        <ProjectReference Include="..\Apache.Calcite.EntityFrameworkCore.BenchmarkUtilities\Apache.Calcite.EntityFrameworkCore.BenchmarkUtilities.csproj" />
        <ProjectReference Include="..\Apache.Calcite.EntityFrameworkCore\Apache.Calcite.EntityFrameworkCore.csproj" />
    </ItemGroup>

</Project>
