<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);MAVEN0012</NoWarn>
        <AssemblyName>Apache.Calcite.EntityFrameworkCore.Adapter.Benchmarks</AssemblyName>
        <RootNamespace>Apache.Calcite.EntityFrameworkCore.Adapter.Benchmarks</RootNamespace>

        <!-- BenchmarkDotNet rebuilds the benchmark assembly into a generated project and refuses to run against a
             debug build; both are the defaults it expects of a benchmark host. -->
        <Optimize Condition=" '$(Configuration)' == 'Release' ">true</Optimize>
        <ServerGarbageCollection>false</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageReference Include="IKVM" Version="8.16.0" />
        <!-- Not PrivateAssets, deliberately. This package ships only buildTransitive, which is the folder that
             carries build assets to consumers; marking it private disables the one mechanism it has, and a project
             that references ours then compiles and fails at run time with `Could not load file or assembly
             'calcite.core'`. The default PrivateAssets keeps `build` to ourselves and lets buildTransitive through. -->
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    </ItemGroup>

    <ItemGroup>
        <MavenReference Include="org.apache.calcite:calcite-linq4j" Version="1.42.0" />
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.42.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Apache.Calcite.EntityFrameworkCore.Adapter\Apache.Calcite.EntityFrameworkCore.Adapter.csproj" />
        <ProjectReference Include="..\Apache.Calcite.EntityFrameworkCore.BenchmarkUtilities\Apache.Calcite.EntityFrameworkCore.BenchmarkUtilities.csproj" />
    </ItemGroup>

</Project>
