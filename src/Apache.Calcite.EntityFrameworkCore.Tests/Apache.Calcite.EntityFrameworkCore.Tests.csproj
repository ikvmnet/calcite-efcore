<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <TargetFramework>net10.0</TargetFramework>
        <NoWarn>$(NoWarn);MAVEN0012</NoWarn>
        <MavenAdditionalRepositories>$(MavenAdditionalRepositories);redhat=https://maven.repository.redhat.com/ga/</MavenAdditionalRepositories>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Apache.Calcite.Geography" Version="2.0.1-pre.188" />
        <PackageReference Include="IKVM" Version="8.16.1" />
        <!-- Not PrivateAssets, deliberately. This package ships only buildTransitive, which is the folder that
             carries build assets to consumers; marking it private disables the one mechanism it has, and a project
             that references ours then compiles and fails at run time with `Could not load file or assembly
             'calcite.core'`. The default PrivateAssets keeps `build` to ourselves and lets buildTransitive through. -->
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" Version="10.0.8" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- commons-text normalizes for CONTAINS_SUBSTR and calls Range.of, which arrived in
             commons-lang3 3.13; the closure otherwise mediates to 3.1 and the call fails at run time
             with NoSuchMethodError. A direct declaration wins that mediation. -->
        <MavenReference Include="org.apache.commons:commons-lang3" Version="3.18.0" />
        <MavenReference Include="org.apache.calcite:calcite-linq4j" Version="1.43.0-SNAPSHOT" />
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.43.0-SNAPSHOT" />
        <MavenReference Include="org.apache.calcite:calcite-server" Version="1.43.0-SNAPSHOT" />
        <MavenReference Include="org.apache.calcite:calcite-csv" Version="1.43.0-SNAPSHOT" />
        <MavenReference Include="org.apache.calcite:calcite-file" Version="1.43.0-SNAPSHOT" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Apache.Calcite.EntityFrameworkCore\Apache.Calcite.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\Apache.Calcite.EntityFrameworkCore.NetTopologySuite\Apache.Calcite.EntityFrameworkCore.NetTopologySuite.csproj" />
        <ProjectReference Include="..\Apache.Calcite.EntityFrameworkCore.TestUtilities\Apache.Calcite.EntityFrameworkCore.TestUtilities.csproj" />
    </ItemGroup>

</Project>
