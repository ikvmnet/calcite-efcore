<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <NoWarn>EF1001</NoWarn>
        <Description>Apache Calcite provider for Entity Framework Core. Plans and executes SQL against any Calcite-modeled data source via IKVM.</Description>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>apache;calcite;entity-framework-core;efcore;provider;sql;ikvm</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="IKVM" Version="8.16.0" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.16.0" />
        <!-- Not PrivateAssets, deliberately. This package ships only buildTransitive, which is the folder that
             carries build assets to consumers; marking it private disables the one mechanism it has, and a project
             that references ours then compiles and fails at run time with `Could not load file or assembly
             'calcite.core'`. The default PrivateAssets keeps `build` to ourselves and lets buildTransitive through. -->
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.0" />
        <PackageReference Include="Apache.Calcite.Data" Version="2.0.0-pre.9" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
    </ItemGroup>

    <ItemGroup>
        <MavenReference Include="org.apache.calcite:calcite-linq4j" Version="1.42.0" />
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.42.0" />
        <MavenReference Include="org.apache.calcite:calcite-server" Version="1.42.0" />
        <MavenReference Include="org.jooq:joou-java-6" Version="0.9.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Apache.Calcite.EntityFrameworkCore.Core\Apache.Calcite.EntityFrameworkCore.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="." Visible="false" />
        <None Include="..\..\README.md" Pack="true" PackagePath="." Visible="false" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="." Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\CalciteStrings.Designer.cs">
            <DependentUpon>CalciteStrings.resx</DependentUpon>
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\CalciteStrings.resx">
            <LastGenOutput>CalciteStrings.Designer.cs</LastGenOutput>
            <Generator>ResXFileCodeGenerator</Generator>
        </EmbeddedResource>
    </ItemGroup>

</Project>
